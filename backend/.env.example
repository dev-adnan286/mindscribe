# --- Core -------------------------------------------------------------------
APP_NAME=MindScribe API
ENVIRONMENT=development            # development | test | production
DEBUG=false
LOG_LEVEL=INFO

# SQLite for local dev (default). PostgreSQL + pgvector for production:
# DATABASE_URL=postgresql+asyncpg://mindscribe:mindscribe@localhost:5432/mindscribe
DATABASE_URL=sqlite+aiosqlite:///./mindscribe.db

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20

# --- AI ---------------------------------------------------------------------
# mock (default, offline) | anthropic | openai
AI_PROVIDER=mock
# hashing (default, offline) | openai
EMBEDDING_PROVIDER=hashing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHAT_TOP_K=5
